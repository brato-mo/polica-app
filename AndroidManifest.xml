<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ba.polica">

    <!-- Barcode scanner. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The interface is a local web page served by the app itself; every outside request is blocked in code,
         except the store system's web front in its own screen, where the employee signs in. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update: the app downloads its own new version and asks Android to install it (the user confirms). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Background look at the order numbers: a notification, and the schedule survives a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A scheduled job that needs the network must hold this since Android 14. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:largeHeap="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share" a planogram PDF from mail, Teams or the file manager -->
            <intent-filter android:label="@string/import_label">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
            <!-- "Open with" -->
            <intent-filter android:label="@string/import_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|screenSize|uiMode"
            android:theme="@style/ScanTheme" />

        <!-- StoreFront: its own sign-in page, shown inside the app -->
        <activity
            android:name=".StorefrontActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density" />
        <!-- StoreFront customer orders (Ispunjen, Stigao): read to flag articles that customers ordered -->
        <activity
            android:name=".OrdersActivity"
            android:exported="false"
            android:theme="@style/PopupTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density" />
        <!-- StoreFront article search: the articles with status 21 and 81 that are in stock -->
        <activity
            android:name=".ClearanceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density" />
        <receiver android:name=".UpdateReceiver" android:exported="false" />
        <service android:name=".OrderWatch" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
